# REQMGR settings — copy to /etc/reqmgr.env and run: sudo chmod 600 /etc/reqmgr.env

# SQLite database: all users, projects, members and backups
REQMGR_DB=/var/lib/reqmgr/reqmgr.db

# Password for the "admin" account created on the very first start.
# Only read while the database has no users; remove it after logging in.
REQMGR_ADMIN_PASSWORD=change-me

# Session cookies are HTTPS-only (keep at 1 behind Caddy / HTTPS)
REQMGR_SECURE_COOKIES=1

# Nightly backups (deploy/backup.sh)
REQMGR_BACKUP_DIR=/var/lib/reqmgr/backups
REQMGR_BACKUP_KEEP=14
# Optional: also copy each backup to S3 (needs the AWS CLI and an instance role)
#REQMGR_BACKUP_S3=s3://your-bucket/reqmgr
